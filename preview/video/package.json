{
  "name": "rview-video",
  "version": "1.0.0",
  "private": true,
  "description": "rView promotional video",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs && node scripts/make-music.mjs",
    "predev": "pnpm assets",
    "dev": "remotion studio",
    "lint": "tsc",
    "prerender": "pnpm assets",
    "render": "remotion render RView rview.mp4 --codec=h264 --crf=18 && remotion still RView poster.png --frame=450"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/media": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
